{
  "name": "clawsense",
  "version": "0.1.0",
  "private": true,
  "description": "A macOS menu bar layer that captures your screen, sends it to Claude Code, and proposes the next thing to do.",
  "license": "MIT",
  "author": {
    "name": "haku10-co",
    "url": "https://github.com/haku10-co"
  },
  "homepage": "https://github.com/haku10-co/clawsense#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haku10-co/clawsense.git"
  },
  "bugs": {
    "url": "https://github.com/haku10-co/clawsense/issues"
  },
  "keywords": [
    "claude-code",
    "claude",
    "anthropic",
    "menu-bar",
    "macos",
    "electron",
    "ai-agent",
    "mcp"
  ],
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "pack": "npm run build && electron-builder --mac --dir",
    "dist": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "com.clawsense.app",
    "productName": "ClawSense",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/renderer/*.html",
      "src/renderer/*.css",
      "package.json",
      "!**/*.map",
      "!**/*.ts"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "extendInfo": {
        "LSUIElement": true,
        "NSScreenCaptureUsageDescription": "ClawSense は作業中の画面を Claude Code に渡して、次の方向性を提案するために画面収録を使用します。",
        "NSAppleEventsUsageDescription": "ClawSense は現在アクティブなアプリ名を取得するために、System Events への AppleScript 送信を使用します。"
      }
    },
    "dmg": {
      "writeUpdateInfo": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "electron": "^36.0.0",
    "electron-builder": "^26.8.1",
    "typescript": "^5.8.0"
  }
}
